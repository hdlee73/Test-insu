<?xml version="1.0" encoding="utf-8"?>
<!-- 주민등록번호가 담긴 DB·설정이 클라우드 백업이나 기기 간 이전으로 빠져나가지 않게 모두 제외한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
